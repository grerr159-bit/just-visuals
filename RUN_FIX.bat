@echo off
chcp 65001 >nul
title Исправление кодировки Java файлов

echo.
echo ╔════════════════════════════════════════════════════════╗
echo ║                                                        ║
echo ║     АВТОМАТИЧЕСКОЕ ИСПРАВЛЕНИЕ КОДИРОВКИ              ║
echo ║                                                        ║
echo ╚════════════════════════════════════════════════════════╝
echo.
echo Этот скрипт автоматически найдет и исправит все
echo проблемы с кодировкой в Java файлах проекта.
echo.
echo Нажмите любую клавишу для начала...
pause >nul

cls
echo.
echo Запуск скрипта исправления...
echo.

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0final_fix.ps1"

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ════════════════════════════════════════════════════════
    echo.
    echo ✓ Скрипт выполнен успешно!
    echo.
    echo ════════════════════════════════════════════════════════
) else (
    echo.
    echo ════════════════════════════════════════════════════════
    echo.
    echo ✗ Произошла ошибка при выполнении
    echo.
    echo ════════════════════════════════════════════════════════
)

echo.
pause
